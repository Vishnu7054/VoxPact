# VoxPact MongoDB Configuration Example
# Local MongoDB connection:
MONGODB_URI=mongodb://localhost:27017/voxpact

# Or MongoDB Atlas Cloud (uncomment and replace credentials):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.yourdomain.mongodb.net/voxpact?retryWrites=true&w=majority

MONGODB_DB=voxpact
PORT=3001
